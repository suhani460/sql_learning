DROP TABLE IF EXISTS ptli;
DROP TABLE IF EXISTS moti;

CREATE TABLE moti (
    id INT PRIMARY KEY,
    name VARCHAR(30)
);

CREATE TABLE ptli (
    order_id INT PRIMARY KEY,
    cust_id INT,
    FOREIGN KEY (cust_id)
    REFERENCES moti(id)
    ON DELETE CASCADE
);

