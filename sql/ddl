CREATE DATABASE org;
SHOW DATABASES;
USE org;

CREATE TABLE worker (
    worker_id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(56),
    last_name VARCHAR(78),
    salary INT,
    joining_date DATETIME,
    department VARCHAR(67)
);

