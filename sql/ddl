CREATE TABLE bonus (
    worker_ref_id INT,
    bonus_amount INT,
    bonus_date DATETIME,
    FOREIGN KEY (worker_ref_id)
    REFERENCES worker(worker_id)
    ON DELETE CASCADE
);

